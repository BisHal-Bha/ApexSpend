# Database (local MongoDB — install & run mongod first)
MONGODB_URI=mongodb://localhost:27017/apexspend

# JWT (change this to a strong random string in production)
JWT_SECRET=CHANGE_ME_to_a_strong_random_secret

# Server
PORT=5000
NODE_ENV=development

# Client (Vite dev server URL)
CLIENT_URL=http://localhost:5173
